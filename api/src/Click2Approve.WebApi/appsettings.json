{
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://click2approve.com",
    "https://click2approve.com",
    "http://www.click2approve.com",
    "https://www.click2approve.com"
  ],
  "Authentication": {
    "BearerTokenExpirationInMinutes": 60,
    "RefreshTokenExpirationInDays": 7
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "FileStorage": {
    "ConnectionString": "",
    "PrivateContainerName": "private",
    "PublicContainerName": "public"
  },
  "Identity": {
    "RequireConfirmedEmail": true,
    "Lockout": {
      "AllowedForNewUsers": true,
      "LockoutTimeSpanInMinutes": 5,
      "MaxFailedAccessAttempts": 3
    },
    "Password": {
      "RequiredLength": 8
    }
  },
  "Limitations": {
    "AvatarImageSize": 256,
    "LogoImageSize": 256,
    "AllowedAvatarExtensions": [
      ".gif",
      ".jfif",
      ".jpeg",
      ".jpg",
      ".png",
      ".webp"
    ],
    "MaxApprovalRequestsPerDay": 10,
    "MaxAssigneesPerRequest": 10,
    "MaxFiles": 100,
    "MaxFileSizeBytes": 4194304
  },
  "Passkeys": {
    "Origins": [
      "https://click2approve.com",
      "https://www.click2approve.com"
    ],
    "RelyingPartyId": "click2approve.com",
    "RelyingPartyName": "Click2Approve"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "Product": {
    "Capabilities": {
      "ApprovalStepTemplates": false,
      "ApprovalRequestRevisions": false,
      "Discussions": false,
      "DiscussionAttachments": false,
      "TaskAttachments": false,
      "EmployeeAssignees": false,
      "TeamAssignees": false,
      "Tenants": false
    },
    "Edition": "OpenSource"
  },
  "UI": {
    "AppPath": "/app",
    "BaseUrl": "https://click2approve.com"
  },
  "Urls": "http://*:5555"
}
