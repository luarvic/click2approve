{
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://click2approve.com",
    "https://click2approve.com",
    "http://www.click2approve.com",
    "https://www.click2approve.com"
  ],
  "Authentication": {
    "EmailConfirmation": {
      "EmailPermitLimit": 3,
      "EmailWindowMinutes": 15
    },
    "Lockout": {
      "DurationMinutes": 5,
      "MaxFailedAttempts": 3
    },
    "Passkeys": {
      "Origins": [
        "https://click2approve.com",
        "https://www.click2approve.com"
      ],
      "RelyingPartyId": "click2approve.com",
      "RelyingPartyName": "Click2Approve"
    },
    "Password": {
      "RequiredLength": 8
    },
    "PasswordReset": {
      "EmailPermitLimit": 3,
      "EmailWindowMinutes": 15
    },
    "Tokens": {
      "AccessTokenLifetimeMinutes": 60,
      "RefreshTokenLifetimeDays": 7
    },
    "VerificationEnabled": true
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "FileStorage": {
    "PrivateContainerName": "private",
    "PublicContainerName": "public",
    "ServiceUri": ""
  },
  "Limitations": {
    "AllowedAvatarExtensions": [
      ".gif",
      ".jfif",
      ".jpeg",
      ".jpg",
      ".png",
      ".webp"
    ],
    "AvatarImageSize": 256,
    "LogoImageSize": 256,
    "MaxFileSizeBytes": 4194304
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "Product": {
    "Capabilities": {
      "ApiTokens": false,
      "ApprovalRequestRevisions": false,
      "ApprovalStepTemplates": false,
      "DiscussionAttachments": false,
      "Discussions": false,
      "EmployeeAssignees": false,
      "Subscriptions": false,
      "TaskAttachments": false,
      "TeamAssignees": false,
      "Tenants": false
    },
    "Edition": "OpenSource"
  },
  "UI": {
    "AppPath": "/app",
    "BaseUrl": "https://click2approve.com"
  },
  "Urls": "http://*:5555",
  "UserFiles": {
    "UnattachedDeletionDelay": "24:00:00"
  }
}
