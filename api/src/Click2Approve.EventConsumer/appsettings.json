{
  "Logging": {
    "LogLevel": {
      "Azure.Core": "Warning"
    }
  },
  "AzureEmailCommunication": {
    "ConnectionString": "",
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 5
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "FileStorage": {
    "ConnectionString": "",
    "PrivateContainerName": "private",
    "PublicContainerName": "public"
  },
  "Email": {
    "FromEmailAddress": "DoNotReply@click2approve.com",
    "IsEnabled": true
  },
  "EventQueue": {
    "ConnectionString": "",
    "Queues": {
      "High": { "Name": "events-high", "PoisonName": "events-high-poison" },
      "Medium": { "Name": "events-medium", "PoisonName": "events-medium-poison" },
      "Low": { "Name": "events-low", "PoisonName": "events-low-poison" }
    },
    "Consumer": {
      "IdleDelaySeconds": 2,
      "MaximumAttempts": 5,
      "MaximumRetryDelaySeconds": 300,
      "VisibilityTimeoutSeconds": 120,
      "Workers": {
        "High": 2,
        "Medium": 2,
        "Low": 1
      }
    }
  },
  "UI": {
    "AppPath": "/app",
    "BaseUrl": "https://click2approve.com"
  }
}
